{
  "rules": {
    "inquiries": {
      ".read": "auth != null",
      ".write": true,
      ".indexOn": ["createdAt", "status"],
      "$inquiryId": {
        ".validate": "newData.hasChildren(['parentName','childName','classApplying','phone']) || auth != null"
      }
    },
    "messages": {
      ".read": "auth != null",
      ".write": true,
      ".indexOn": ["createdAt"],
      "$messageId": {
        ".validate": "newData.hasChildren(['name','message']) || auth != null"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
