{
  "rules": {
    "properties": {
      ".read": true,
      ".write": false
    },
    "leads": {
      ".read": false,
      "$leadId": {
        ".write": "!data.exists() && newData.exists() && newData.child('email').isString() && newData.child('firstName').isString()",
        ".validate": "newData.hasChildren(['id','kind','createdAt','email','firstName','lastName'])"
      }
    }
  }
}
